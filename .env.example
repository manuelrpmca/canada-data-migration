# Copy to .env and fill in locally. .env is git-ignored. In CI these come from GitHub Actions secrets.
# v0.1 needs none of these: both public APIs require no key.

# Phase 2: BigQuery (sandbox project)
GCP_PROJECT_ID=
BQ_DATASET=
GOOGLE_APPLICATION_CREDENTIALS=

# Phase 2: Oracle Database Free (local Docker container). `uv run cdm oracle up` fills the three
# passwords in .env with random values if they are empty. ORACLE_DSN defaults to
# localhost:1521/FREEPDB1; ORACLE_PORT (default 1521) changes the port on this computer.
ORACLE_PASSWORD=
ORACLE_LOADER_PASSWORD=
ORACLE_MIGRATION_PASSWORD=
ORACLE_DSN=

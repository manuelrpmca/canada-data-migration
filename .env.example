# Copy to .env and fill in locally. .env is git-ignored. In CI these come from GitHub Actions secrets.
# v0.1 needs none of these: both public APIs require no key.

# Phase 2: BigQuery (sandbox project)
GCP_PROJECT_ID=
BQ_DATASET=
GOOGLE_APPLICATION_CREDENTIALS=

# Phase 2: Oracle Database Free (local Docker container)
ORACLE_PASSWORD=
ORACLE_DSN=
